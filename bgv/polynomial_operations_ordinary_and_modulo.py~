# Representing a polynomial using a Python list

p = [3, 4, 5, 1]
q = [1, 6, 3, 9]

# Ordinary Addition
result_add = []

for i in range(len(p)):
        result_add.append(p[i] + q[i])

# Ordinary Multiplication
result_mult = [0] * (len(p) + len(q) - 1)

for i in range(len(p)):
        for j in range(len(q)):
                result_mult[i + j ] += p[i] * q[j]

print("p = ", p)
print("q = ", q)
print("p + q =", result_add)
print("p * q =", result_mult)

# Representing a polynomial using a Python list

modulus = int(input("Enter the coefficent modulus: "))

p = [3, 4, 5, 1]
q = [1, 6, 3, 9]

# Modulo Addition
result_add = []

for i in range(len(p)):
	result_add.append((p[i] + q[i]) % modulus)

# Modulo Multiplication
result_mult = [0] * (len(p) + len(q) - 1)

for i in range(len(p)):
	for j in range(len(q)):
		result_mult[i + j ] += p[i] * q[j]

for i in range(len(result_mult)):
	result_mult[i] = result_mult[i] % modulus

print("p = ", p)
print("q = ", q)
print("p + q =", result_add)
print("p * q =", result_mult)
